# Vercel → Project → Settings → Environment Variables
# Criar exatamente duas variáveis SECRET, sem NEXT_PUBLIC_:
# GA4_OAUTH_JSON={"client_id":"...","client_secret":"...","refresh_token":"..."}
# GSC_OAUTH_JSON={"client_id":"...","client_secret":"...","refresh_token":"..."}
# Na Vercel, NÃO é necessário criar arquivos JSON nem configurar seus caminhos.

# Identificadores das propriedades (não são segredos; os valores abaixo já são os padrões do código)
GA4_WEB_PROPERTY_ID=326427533
GA4_AMP_PROPERTY_ID=410193156

# Alternativa apenas para desenvolvimento local, com os JSONs que você já possui:
# GA4_CLIENT_SECRET_FILE=C:/.../ga4_oauth_client.json
# GA4_TOKEN_FILE=C:/.../ga4_oauth_token_producao.json
# GSC_TOKEN_FILE=C:/.../cidadeon_gsc_diagnostico.json

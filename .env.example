# Configuração local (Windows) — os JSONs nunca entram na imagem Docker
GA4_WEB_PROPERTY_ID=326427533
GA4_AMP_PROPERTY_ID=410193156
GA4_CLIENT_SECRET_FILE=C:/CAMINHO/SEGURO/ga4_oauth_client.json
GA4_TOKEN_FILE=C:/CAMINHO/SEGURO/ga4_oauth_token_producao.json
GSC_TOKEN_FILE=C:/CAMINHO/SEGURO/cidadeon_gsc_diagnostico.json
# No Snowflake, o spec.yaml define automaticamente:
# SNOWFLAKE_GA4_ACCESS_TOKEN_FILE=/app/google-secrets/ga4/access_token
# SNOWFLAKE_GSC_ACCESS_TOKEN_FILE=/app/google-secrets/gsc/access_token
